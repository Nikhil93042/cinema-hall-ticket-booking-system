# Environment Configuration Example
# For SQLite (default local zero-friction setup):
DATABASE_URL="file:./dev.db"

# For MongoDB Atlas (cloud cluster):
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.uwqvu20.mongodb.net/cinemadb?retryWrites=true&w=majority"

# For PostgreSQL (production or local PostgreSQL instance):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/cinemadb?schema=public"

JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
